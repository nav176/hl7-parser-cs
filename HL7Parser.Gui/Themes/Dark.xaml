<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBg"          Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SurfaceBg"      Color="#252526"/>
    <SolidColorBrush x:Key="RaisedBg"       Color="#2D2D30"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="ThemeBorder"    Color="#3E3E42"/>

    <!-- Foregrounds -->
    <SolidColorBrush x:Key="Fg"             Color="#CCCCCC"/>
    <SolidColorBrush x:Key="MutedFg"        Color="#858585"/>
    <SolidColorBrush x:Key="HintFg"         Color="#6A6A6A"/>
    <SolidColorBrush x:Key="SubNodeFg"      Color="#909090"/>

    <!-- Secondary buttons -->
    <SolidColorBrush x:Key="SecFg"          Color="#CCCCCC"/>
    <SolidColorBrush x:Key="SecBorder"      Color="#4A4A4E"/>
    <SolidColorBrush x:Key="SecHover"       Color="#3E3E42"/>
    <SolidColorBrush x:Key="SecPressed"     Color="#333337"/>

    <!-- Disabled state -->
    <SolidColorBrush x:Key="DisabledFg"     Color="#555558"/>
    <SolidColorBrush x:Key="DisabledBg"     Color="#333337"/>
    <SolidColorBrush x:Key="DisabledBorder" Color="#3E3E42"/>

    <!-- Tab hover -->
    <SolidColorBrush x:Key="TabHoverBorder" Color="#4A4A4E"/>
    <SolidColorBrush x:Key="TabHoverFg"     Color="#CCCCCC"/>

    <!-- Search match highlights (softened, WCAG AA compliant) -->
    <SolidColorBrush x:Key="MatchBg"         Color="#3D3200"/>  <!-- dark gold   -->
    <SolidColorBrush x:Key="MatchFg"         Color="#FFE080"/>  <!-- light gold  -->
    <SolidColorBrush x:Key="MatchActiveBg"   Color="#7A3D00"/>  <!-- burnt orange -->
    <SolidColorBrush x:Key="MatchActiveFg"   Color="#FFB347"/>  <!-- light orange -->

    <!-- Status bar states -->
    <SolidColorBrush x:Key="StatusOkBg"     Color="#252526"/>
    <SolidColorBrush x:Key="StatusOkBorder" Color="#3E3E42"/>
    <SolidColorBrush x:Key="StatusOkFg"     Color="#858585"/>
    <SolidColorBrush x:Key="StatusErrBg"    Color="#3D1515"/>
    <SolidColorBrush x:Key="StatusErrBorder" Color="#5C1E1E"/>
    <SolidColorBrush x:Key="StatusErrFg"    Color="#EF9A9A"/>

</ResourceDictionary>
