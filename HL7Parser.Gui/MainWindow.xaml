<Window x:Class="HL7Parser.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HL7 Parser" MinWidth="960" MinHeight="680"
        Background="#F0F2F5" FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style TargetType="TabItem"> 
            <Setter Property="Foreground" Value="#65676B"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Padding"    Value="20,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp" ContentSource="Header"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1877F2"/>
                                <Setter TargetName="cp" Property="TextBlock.Foreground" Value="#1877F2"/>
                                <Setter TargetName="cp" Property="TextBlock.FontWeight"  Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#C5C7CA"/>
                                <Setter TargetName="cp" Property="TextBlock.Foreground" Value="#1C1E21"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1877F2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#166FE5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1464D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E4E6EA"/>
                                <Setter Property="Foreground" Value="#BEC3C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#1C1E21"/>
            <Setter Property="BorderBrush"     Value="#CED0D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="#F2F3F5"/>
                                <Setter Property="BorderBrush" Value="#8A8D91"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E4E6EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Height="52" Background="White"
                BorderBrush="#E4E6EA" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,0" VerticalAlignment="Center">
                <Border Background="#1877F2" CornerRadius="4" Padding="8,2"
                        VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="HL7" Foreground="White" FontWeight="ExtraBold"
                               FontSize="13" VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="ParseBtn" DockPanel.Dock="Right" Content="Parse"
                        Width="72" Height="32" Style="{StaticResource PrimaryBtn}"
                        IsEnabled="False" Click="OnParse"/>
                <Button x:Name="BrowseBtn" DockPanel.Dock="Right" Content="Browse…"
                        Width="84" Height="32" Style="{StaticResource SecBtn}"
                        Margin="0,0,8,0" Click="OnBrowse"/>
                <TextBox x:Name="PathBox" IsReadOnly="True" Height="32"
                         VerticalContentAlignment="Center" Padding="10,0"
                         Background="#F7F8FA" Foreground="#65676B"
                         BorderBrush="#CED0D4" BorderThickness="1.5"
                         Text="No file selected — click Browse to open an HL7 file"/>
            </DockPanel>
        </Border>

        <!-- Text input area -->
        <Border DockPanel.Dock="Top" Background="White"
                BorderBrush="#E4E6EA" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="— or paste an HL7 message directly —"
                           Foreground="#65676B" FontSize="11" Margin="0,0,0,6"
                           HorizontalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Parse Text"
                        Width="90" Height="32" Style="{StaticResource PrimaryBtn}"
                        VerticalAlignment="Bottom" Margin="10,0,0,0" Click="OnParseText"/>
                <TextBox x:Name="MessageInputBox"
                         AcceptsReturn="True" AcceptsTab="False"
                         TextWrapping="NoWrap" Height="90"
                         FontFamily="Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#F7F8FA" BorderBrush="#CED0D4" BorderThickness="1.5"
                         Padding="8,6" VerticalContentAlignment="Top"/>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Height="24"
                Background="#F7F8FA" BorderBrush="#E4E6EA" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Margin="8,0" VerticalAlignment="Center"
                       FontSize="11" Foreground="#65676B"
                       Text="Open an HL7 file to begin."/>
        </Border>

        <!-- Tabs -->
        <TabControl x:Name="Tabs" Background="#F0F2F5" BorderThickness="0">
            <TabItem Header="Segments">
                <DockPanel Background="White">
                    <Border DockPanel.Dock="Top" Height="40" Background="#F7F8FA"
                            BorderBrush="#E4E6EA" BorderThickness="0,0,0,1">
                        <DockPanel Margin="10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="ExpandBtn" Content="Expand All" Width="90" Height="28"
                                        Style="{StaticResource SecBtn}" IsEnabled="False"
                                        Click="OnExpandAll" Margin="0,0,6,0"/>
                                <Button x:Name="CollapseBtn" Content="Collapse All" Width="94" Height="28"
                                        Style="{StaticResource SecBtn}" IsEnabled="False"
                                        Click="OnCollapseAll" Margin="0,0,12,0"/>
                                <TextBlock Text="Zoom:" VerticalAlignment="Center"
                                           Foreground="#65676B" FontSize="11" Margin="0,0,6,0"/>
                                <Button Content="−" Width="28" Height="28"
                                        Style="{StaticResource SecBtn}" Margin="0,0,4,0"
                                        Click="OnZoomOut"/>
                                <TextBlock x:Name="ZoomLabel" Text="100%" Width="36"
                                           VerticalAlignment="Center" TextAlignment="Center"
                                           Foreground="#65676B" FontSize="11" Margin="0,0,4,0"/>
                                <Button Content="+" Width="28" Height="28"
                                        Style="{StaticResource SecBtn}" Click="OnZoomIn"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <TextBlock Text="Search:" VerticalAlignment="Center"
                                           Foreground="#65676B" FontSize="11" Margin="0,0,6,0"/>
                                <TextBox x:Name="SearchBox" Width="240" Height="28"
                                         VerticalContentAlignment="Center" Padding="8,0"
                                         Background="White" BorderBrush="#CED0D4" BorderThickness="1.5"
                                         TextChanged="OnSearchChanged"/>
                                <Button Content="✕" Width="28" Height="28"
                                        Style="{StaticResource SecBtn}" Margin="4,0,0,0"
                                        Click="OnSearchClear"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TreeView x:Name="SegTree" BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                             Color="#0033A0"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                             Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                             Color="#0033A0"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                             Color="White"/>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Raw JSON">
                <TextBox x:Name="JsonView" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="9"
                         Background="#F7F8FA" BorderThickness="0"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
