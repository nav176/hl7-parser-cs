<Window x:Class="HL7Parser.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VytlOne HL7 Parser" MinWidth="960" MinHeight="680"
        Background="#FAFAFA" FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#65676B"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Padding"    Value="22,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp" ContentSource="Header"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0033A0"/>
                                <Setter TargetName="cp" Property="TextBlock.Foreground" Value="#0033A0"/>
                                <Setter TargetName="cp" Property="TextBlock.FontWeight"  Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#C5C7CA"/>
                                <Setter TargetName="cp" Property="TextBlock.Foreground" Value="#1E1E1E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#0033A0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#002D8C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#002070"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#E4E6EA"/>
                                <Setter Property="Foreground"                  Value="#BEC3C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#1E1E1E"/>
            <Setter Property="BorderBrush"     Value="#D0D3D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"  Value="#EAECF0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A0A3A8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D8DBE0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E4E6EA"/>
                                <Setter Property="Foreground"                   Value="#BEC3C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon-only button: no border, transparent bg, hover fill -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#1E1E1E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAECF0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D8DBE0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#BEC3C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Height="56" Background="White"
                BorderBrush="#E0E3E8" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0" VerticalAlignment="Center">
                <Image Source="Assets/vytlone_logo.png" Height="34"
                       VerticalAlignment="Center" Margin="0,0,20,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Button x:Name="ParseBtn" DockPanel.Dock="Right" Content="Parse"
                        Width="76" Height="34" Style="{StaticResource PrimaryBtn}"
                        IsEnabled="False" Click="OnParse"/>
                <Button x:Name="BrowseBtn" DockPanel.Dock="Right" Content="Browse…"
                        Width="90" Height="34" Style="{StaticResource SecBtn}"
                        Margin="0,0,8,0" Click="OnBrowse"/>
                <TextBox x:Name="PathBox" IsReadOnly="True" Height="34"
                         VerticalContentAlignment="Center" Padding="12,0"
                         Background="#F7F8FA" Foreground="#8A8D91"
                         BorderBrush="#E0E3E8" BorderThickness="1"
                         Text="No file selected — click Browse to open an HL7 file"/>
            </DockPanel>
        </Border>

        <!-- Paste area -->
        <Border DockPanel.Dock="Top" Background="White"
                BorderBrush="#E0E3E8" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="— or paste an HL7 message directly —"
                           Foreground="#8A8D91" FontSize="11" Margin="0,0,0,6"
                           HorizontalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Parse Text"
                        Width="96" Height="34" Style="{StaticResource PrimaryBtn}"
                        VerticalAlignment="Bottom" Margin="12,0,0,0" Click="OnParseText"/>
                <TextBox x:Name="MessageInputBox"
                         AcceptsReturn="True" AcceptsTab="False"
                         TextWrapping="NoWrap" Height="86"
                         FontFamily="Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#F7F8FA" BorderBrush="#E0E3E8" BorderThickness="1"
                         Padding="10,8" VerticalContentAlignment="Top"/>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Height="26"
                Background="#F7F8FA" BorderBrush="#E0E3E8" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Margin="12,0" VerticalAlignment="Center"
                       FontSize="11" Foreground="#65676B"
                       Text="Open an HL7 file to begin."/>
        </Border>

        <!-- Tabs -->
        <TabControl x:Name="Tabs" Background="#FAFAFA" BorderThickness="0">
            <TabItem Header="Segments">
                <DockPanel Background="White">
                    <Border DockPanel.Dock="Top" Height="44" Background="White"
                            BorderBrush="#E0E3E8" BorderThickness="0,0,0,1">
                        <DockPanel Margin="12,0" VerticalAlignment="Center">

                            <!-- Left: expand / collapse + zoom -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="ExpandBtn" Content="Expand All"
                                        Width="90" Height="30" Style="{StaticResource SecBtn}"
                                        IsEnabled="False" Click="OnExpandAll" Margin="0,0,6,0"/>
                                <Button x:Name="CollapseBtn" Content="Collapse All"
                                        Width="96" Height="30" Style="{StaticResource SecBtn}"
                                        IsEnabled="False" Click="OnCollapseAll" Margin="0,0,14,0"/>
                                <!-- Divider -->
                                <Border Width="1" Background="#E0E3E8" Margin="0,4"/>
                                <!-- Zoom Out (Segoe MDL2 Assets ZoomOut) -->
                                <Button Style="{StaticResource IconBtn}" Width="30" Height="30"
                                        Margin="6,0,0,0" Click="OnZoomOut" ToolTip="Zoom out">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A4;"
                                               FontSize="14" Foreground="#1E1E1E"
                                               VerticalAlignment="Center"/>
                                </Button>
                                <TextBlock x:Name="ZoomLabel" Text="100%" Width="38"
                                           VerticalAlignment="Center" TextAlignment="Center"
                                           Foreground="#65676B" FontSize="11" Margin="2,0"/>
                                <!-- Zoom In (Segoe MDL2 Assets ZoomIn) -->
                                <Button Style="{StaticResource IconBtn}" Width="30" Height="30"
                                        Click="OnZoomIn" ToolTip="Zoom in">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A3;"
                                               FontSize="14" Foreground="#1E1E1E"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <!-- Right: search box + prev / next -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                        VerticalAlignment="Center">
                                <!-- Search box with inline magnifier icon -->
                                <Border BorderBrush="#D0D3D8" BorderThickness="1" CornerRadius="7"
                                        Background="White" Height="30">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;"
                                                   FontSize="11" Foreground="#8A8D91"
                                                   VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox x:Name="SearchBox" Width="210"
                                                 VerticalContentAlignment="Center" Padding="0,0,6,0"
                                                 Background="Transparent" BorderThickness="0"
                                                 TextChanged="OnSearchChanged"/>
                                    </StackPanel>
                                </Border>
                                <!-- Find Previous -->
                                <Button Style="{StaticResource IconBtn}" Width="30" Height="30"
                                        Margin="6,0,2,0" Click="OnFindPrev"
                                        ToolTip="Previous match">
                                    <TextBlock Text="▲" FontSize="10" Foreground="#1E1E1E"
                                               VerticalAlignment="Center"/>
                                </Button>
                                <!-- Find Next -->
                                <Button Style="{StaticResource IconBtn}" Width="30" Height="30"
                                        Click="OnFindNext" ToolTip="Next match">
                                    <TextBlock Text="▼" FontSize="10" Foreground="#1E1E1E"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                        </DockPanel>
                    </Border>
                    <TreeView x:Name="SegTree" BorderThickness="0" FontSize="12"
                              VirtualizingPanel.IsVirtualizing="True">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                             Color="#0033A0"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                             Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                             Color="#0033A0"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                             Color="White"/>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Raw JSON">
                <TextBox x:Name="JsonView" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="11"
                         Background="#F7F8FA" BorderThickness="0"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
