<Window x:Class="HL7Parser.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="VytlOne HL7 Parser" MinWidth="960" MinHeight="680"
        Background="{DynamicResource AppBg}" FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedFg}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Padding"    Value="22,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource AppBg}">
                            <ContentPresenter x:Name="cp" ContentSource="Header"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0033A0"/>
                                <Setter TargetName="cp" Property="TextBlock.Foreground" Value="#0033A0"/>
                                <Setter TargetName="cp" Property="TextBlock.FontWeight"  Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TabHoverBorder}"/>
                                <Setter TargetName="cp" Property="TextBlock.Foreground" Value="{DynamicResource TabHoverFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#0033A0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#002D8C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#002070"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DisabledBg}"/>
                                <Setter Property="Foreground"                  Value="{DynamicResource DisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource SecFg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource SecBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"  Value="{DynamicResource SecHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TabHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SecPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource DisabledBorder}"/>
                                <Setter Property="Foreground"                   Value="{DynamicResource DisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource Fg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SecHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SecPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="140" MinHeight="80"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Paste / input area -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Content="Load File" Width="84" Height="34"
                            Style="{StaticResource SecBtn}" Click="OnLoadFile" Margin="0,0,8,0"/>
                    <Button Content="Parse" Width="76" Height="34"
                            Style="{StaticResource PrimaryBtn}" Click="OnParseText"/>
                    <Button x:Name="DarkModeBtn" Style="{StaticResource IconBtn}"
                            Width="34" Height="34" Margin="8,0,0,0"
                            Click="OnToggleDarkMode" ToolTip="Toggle dark mode">
                        <TextBlock x:Name="DarkModeIcon" FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE708;" FontSize="22"
                                   Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
                <avalon:TextEditor x:Name="MessageInputBox"
                                   ShowLineNumbers="True"
                                   WordWrap="False"
                                   FontFamily="Consolas" FontSize="14"
                                   Background="{DynamicResource RaisedBg}"
                                   Foreground="{DynamicResource Fg}"
                                   LineNumbersForeground="{DynamicResource MutedFg}"
                                   BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   Padding="2"/>
            </DockPanel>
        </Border>

        <!-- Row 1: GridSplitter -->
        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource ThemeBorder}" Cursor="SizeNS"/>

        <!-- Row 2: Tabs -->
        <TabControl x:Name="Tabs" Grid.Row="2"
                    Background="{DynamicResource AppBg}" BorderThickness="0">

            <TabItem Header="Segments">
                <DockPanel Background="{DynamicResource SurfaceBg}">
                    <Border DockPanel.Dock="Top" Height="44"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource ThemeBorder}"
                            BorderThickness="0,0,0,1">
                        <DockPanel Margin="12,0" VerticalAlignment="Center" LastChildFill="False">

                            <!-- Right: search (declared first so it docks right) -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                        VerticalAlignment="Center">
                                <Border BorderBrush="{DynamicResource SecBorder}" BorderThickness="1"
                                        CornerRadius="7" Background="{DynamicResource SurfaceBg}"
                                        Height="30">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;"
                                                   FontSize="11" Foreground="{DynamicResource HintFg}"
                                                   VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox x:Name="SearchBox" Width="210"
                                                 VerticalContentAlignment="Center" Padding="0,0,6,0"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource Fg}"
                                                 CaretBrush="{DynamicResource Fg}"
                                                 BorderThickness="0"
                                                 TextChanged="OnSearchChanged"/>
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource IconBtn}" Width="30" Height="30"
                                        Margin="6,0,2,0" Click="OnFindPrev" ToolTip="Previous match">
                                    <TextBlock Text="▲" FontSize="10" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource IconBtn}" Width="30" Height="30"
                                        Click="OnFindNext" ToolTip="Next match">
                                    <TextBlock Text="▼" FontSize="10" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <!-- Left: expand / collapse / hide-empty + zoom -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="ExpandBtn" Content="Expand All"
                                        Width="90" Height="30" Style="{StaticResource SecBtn}"
                                        IsEnabled="False" Click="OnExpandAll" Margin="0,0,6,0"/>
                                <Button x:Name="CollapseBtn" Content="Collapse All"
                                        Width="96" Height="30" Style="{StaticResource SecBtn}"
                                        IsEnabled="False" Click="OnCollapseAll" Margin="0,0,6,0"/>
                                <Button x:Name="HideEmptyBtn" Content="Hide Empty"
                                        Width="96" Height="30" Style="{StaticResource SecBtn}"
                                        IsEnabled="False" Click="OnToggleHideEmpty" Margin="0,0,14,0"/>
                                <Border Width="1" Background="{DynamicResource ThemeBorder}" Margin="0,4"/>
                                <Button Style="{StaticResource IconBtn}" Width="30" Height="30"
                                        Margin="6,0,0,0" Click="OnZoomOut" ToolTip="Zoom out">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A4;"
                                               FontSize="14" VerticalAlignment="Center"/>
                                </Button>
                                <TextBlock x:Name="ZoomLabel" Text="100%" Width="38"
                                           VerticalAlignment="Center" TextAlignment="Center"
                                           Foreground="{DynamicResource MutedFg}"
                                           FontSize="11" Margin="2,0"/>
                                <Button Style="{StaticResource IconBtn}" Width="30" Height="30"
                                        Click="OnZoomIn" ToolTip="Zoom in">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A3;"
                                               FontSize="14" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                        </DockPanel>
                    </Border>
                    <TreeView x:Name="SegTree" BorderThickness="0" FontSize="14"
                              Background="{DynamicResource SurfaceBg}"
                              VirtualizingPanel.IsVirtualizing="True">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                             Color="#0033A0"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                             Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                             Color="#0033A0"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                             Color="White"/>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Raw JSON">
                <avalon:TextEditor x:Name="JsonView"
                                   IsReadOnly="True"
                                   ShowLineNumbers="True"
                                   WordWrap="False"
                                   FontFamily="Consolas" FontSize="11"
                                   Background="{DynamicResource RaisedBg}"
                                   Foreground="{DynamicResource Fg}"
                                   LineNumbersForeground="{DynamicResource MutedFg}"
                                   BorderThickness="0"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"/>
            </TabItem>
        </TabControl>

        <!-- Row 3: Status bar -->
        <Border x:Name="StatusBar" Grid.Row="3"
                Background="{DynamicResource StatusOkBg}"
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Margin="12,0" VerticalAlignment="Center"
                       FontSize="11" Foreground="{DynamicResource StatusOkFg}"
                       Text="Paste an HL7 message and click Parse."/>
        </Border>
    </Grid>
</Window>
